# Copy to .env and fill in. Docker compose reads .env automatically.
# Everything here is OPTIONAL except the login — the app runs with zero API
# keys (routing falls back to great-circle math, fuel to a default price,
# broker check + AI letter show a "configure key" notice).

# --- Basic auth for the dispatcher dashboard ---
DISPATCH_USER=dispatcher
DISPATCH_PASS=change-me-before-first-run

# --- Where the SQLite database lives (inside the container) ---
DATABASE_URL=sqlite:////data/dispatch.db

# --- Routing / mileage (pick ONE, or leave both blank for fallback) ---
# OpenRouteService free key — supports the driving-hgv truck profile + geocoding.
# Sign up free at https://openrouteservice.org/dev/#/signup
ORS_API_KEY=
# ...or point at a self-hosted OSRM instance, e.g. http://osrm:5000
OSRM_URL=

# --- Fuel price (EIA free key) — https://www.eia.gov/opendata/register.php ---
EIA_API_KEY=
# Fallback diesel price (cents/gallon) used when EIA is unavailable
DEFAULT_DIESEL_CPG=420

# --- Broker verification (FMCSA QCMobile free WebKey) ---
# https://mobile.fmcsa.dot.gov/QCDevsite/docs/apiAccess
FMCSA_WEBKEY=

# --- Produce rate seed (USDA AMS MyMarketNews, free key) ---
# Request a key at https://mymarketnews.ams.usda.gov/, point the slug at a
# truck-rate report, and set the per-mile field name. Blank = built-in reference.
USDA_API_KEY=
USDA_TRUCK_REPORT_SLUG=
USDA_RPM_FIELD=avg_mileage_rate
USDA_EQUIPMENT=reefer

# --- AI negotiation letter (Anthropic / Claude) ---
# Leave blank to keep the feature dormant; add a key to enable it.
ANTHROPIC_API_KEY=

# --- Truck economics (used for cost-per-mile + profit) ---
DEFAULT_MPG=6.5
FIXED_MONTHLY_CENTS=900000
AVG_MONTHLY_MILES=10000
MAINT_CPM_CENTS=18
TARGET_MARGIN_PCT=30
